#!/bin/bash
#
# nvr-backup — pull rtmp-nginx-viewer configuration from remote NVR hosts.
#
# Runs from your workstation. Nothing needs to be installed on the servers.
# For each host it opens one SSH connection, tars the config paths remotely,
# and streams the archive straight back to local disk.
#
# Usage:
#   nvr-backup                      # back up every host in the hosts file
#   nvr-backup esps1 esps4          # back up only the named hosts
#   nvr-backup -n                   # dry run, show what would happen
#   nvr-backup -j 8                 # 8 hosts in parallel (default 4)
#   nvr-backup -l                   # list configured hosts and exit
#   nvr-backup -V                   # print version and exit
#
# Hosts file: ~/.config/nvr-backup/hosts
#   One host per line. Blank lines and # comments ignored.
#   Accepts anything ssh accepts, including aliases from ~/.ssh/config:
#       esps1
#       user@esps2.lan
#       esps3.example.com
#
# Config overrides via env or ~/.config/nvr-backup/config:
#   BACKUP_ROOT   where archives land   (default ~/backups/nvr)
#   KEEP          archives kept per host (default 14)
#   SSH_OPTS      extra ssh arguments   (default connect timeout 15s)

VERSION="1.0.0"

set -uo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nvr-backup"
HOSTS_FILE="${HOSTS_FILE:-$CONFIG_DIR/hosts}"
[ -r "$CONFIG_DIR/config" ] && . "$CONFIG_DIR/config"

BACKUP_ROOT="${BACKUP_ROOT:-$HOME/backups/nvr}"
KEEP="${KEEP:-14}"
SSH_OPTS="${SSH_OPTS:--o ConnectTimeout=15 -o BatchMode=yes}"
JOBS="${JOBS:-4}"
DRYRUN=0

# --- Paths pulled from each server ----------------------------------------
REMOTE_PATHS=(
    /etc/nginx
    /etc/rtsp-to-rtmp
    /etc/cron.d/rtmp-nginx-viewer
    /etc/fstab
    /opt/videos-mover
)
# ---------------------------------------------------------------------------

STAMP="$(date +%Y%m%d-%H%M%S)"

c_red=$'\033[31m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
[ -t 1 ] || { c_red=""; c_grn=""; c_yel=""; c_dim=""; c_off=""; }

usage() { sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit "${1:-0}"; }

log()  { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }
ok()   { printf '%s %s%s%s\n' "$(date '+%H:%M:%S')" "$c_grn" "$*" "$c_off"; }
warn() { printf '%s %s%s%s\n' "$(date '+%H:%M:%S')" "$c_yel" "$*" "$c_off"; }
err()  { printf '%s %s%s%s\n' "$(date '+%H:%M:%S')" "$c_red" "$*" "$c_off" >&2; }

while getopts ":j:f:nlhV" opt; do
    case "$opt" in
        j) JOBS="$OPTARG" ;;
        f) HOSTS_FILE="$OPTARG" ;;
        n) DRYRUN=1 ;;
        l) LIST_ONLY=1 ;;
        h) usage 0 ;;
        V) echo "nvr-backup $VERSION"; exit 0 ;;
        \?) err "Unknown option -$OPTARG"; usage 1 ;;
        :)  err "Option -$OPTARG needs an argument"; usage 1 ;;
    esac
done
shift $((OPTIND - 1))

# --- Work out the host list ------------------------------------------------
HOSTS=()
if [ "$#" -gt 0 ]; then
    HOSTS=("$@")
else
    if [ ! -r "$HOSTS_FILE" ]; then
        err "No hosts file at $HOSTS_FILE"
        err "Create it with one host per line, or pass hosts as arguments."
        exit 1
    fi
    while IFS= read -r line; do
        line="${line%%#*}"
        line="$(echo "$line" | xargs 2>/dev/null || true)"
        [ -n "$line" ] && HOSTS+=("$line")
    done < "$HOSTS_FILE"
fi

[ "${#HOSTS[@]}" -gt 0 ] || { err "No hosts to back up."; exit 1; }

if [ "${LIST_ONLY:-0}" -eq 1 ]; then
    printf '%s\n' "${HOSTS[@]}"
    exit 0
fi

# --- Per-host backup -------------------------------------------------------
backup_host() {
    local host="$1"
    local label="${host##*@}"          # strip user@ for the filename
    local dir="$BACKUP_ROOT/$label"
    local archive="$dir/${label}-${STAMP}.tar.gz"

    if [ "$DRYRUN" -eq 1 ]; then
        log "${c_dim}[dry-run]${c_off} $host -> $archive"
        return 0
    fi

    mkdir -p "$dir"

    # Remote side: keep only paths that exist, then tar them to stdout.
    # sudo -n so it fails fast rather than hanging on a password prompt.
    # shellcheck disable=SC2029
    if ! ssh $SSH_OPTS "$host" "sudo -n tar -czf - --absolute-names \
            --warning=no-file-changed --ignore-failed-read \
            \$(for p in ${REMOTE_PATHS[*]}; do [ -e \"\$p\" ] && printf '%s ' \"\$p\"; done)" \
            > "$archive" 2>"$archive.err"; then
        err "FAIL $host — $(tr '\n' ' ' < "$archive.err" | cut -c1-160)"
        rm -f "$archive" "$archive.err"
        return 1
    fi

    rm -f "$archive.err"

    if [ ! -s "$archive" ]; then
        err "FAIL $host — empty archive"
        rm -f "$archive"
        return 1
    fi

    chmod 600 "$archive"
    ok "OK   $host — $(du -h "$archive" | cut -f1) -> $archive"

    # Prune old archives for this host only.
    local old
    mapfile -t old < <(ls -1t "$dir"/${label}-*.tar.gz 2>/dev/null | tail -n +$((KEEP + 1)))
    [ "${#old[@]}" -gt 0 ] && rm -f "${old[@]}"
    return 0
}

# --- Run, bounded parallelism ---------------------------------------------
log "nvr-backup $VERSION — backing up ${#HOSTS[@]} host(s), ${JOBS} at a time -> $BACKUP_ROOT"

STATUS_DIR="$(mktemp -d)"
trap 'rm -rf "$STATUS_DIR"' EXIT

for host in "${HOSTS[@]}"; do
    while [ "$(jobs -rp | wc -l)" -ge "$JOBS" ]; do wait -n 2>/dev/null || sleep 0.2; done
    ( backup_host "$host" || echo "$host" >> "$STATUS_DIR/failed" ) &
done
wait

if [ -s "$STATUS_DIR/failed" ]; then
    echo
    err "Failed hosts:"
    sed 's/^/  /' "$STATUS_DIR/failed" >&2
    exit 1
fi

echo
ok "All ${#HOSTS[@]} host(s) backed up."
